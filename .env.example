# Plexo — Minimal Environment (required to boot)
#
# Copy to .env and fill in, or run: bash scripts/install.sh --domain=plexo.yourdomain.com
# For all available vars see .env.full.example

# ── Domain ───────────────────────────────────────────────────
PUBLIC_URL=https://plexo.yourdomain.com        # Full URL for OAuth callbacks and links
PUBLIC_DOMAIN=plexo.yourdomain.com             # Domain only, used by Caddy TLS

# ── Secrets (generate each: openssl rand -hex 32) ────────────
POSTGRES_PASSWORD=                             # Postgres auth — must match volume
REDIS_PASSWORD=                                # Valkey/Redis auth
SESSION_SECRET=                                # Session encryption (use: openssl rand -hex 64)
ENCRYPTION_SECRET=                             # AES-256-GCM for credential storage
AUTH_SECRET=                                   # Better Auth session signing
PLEXO_SERVICE_KEY=                             # Internal service-to-service auth + HMAC body sig (ADR-0002)

# ── Inngest — durable cron + workflow chaining (ADR-0006) ────
# Auto-generated by install.sh. Required for the gmessages connector
# session-refresh + stale-session monitor + libgmessages bump canary jobs.
INNGEST_SIGNING_KEY=                           # signkey-prod-<openssl rand -hex 32>
INNGEST_EVENT_KEY=                             # openssl rand -hex 32
INNGEST_BASE_URL=http://inngest:8288           # Internal-only; never exposed publicly

# ── Auth ─────────────────────────────────────────────────────
BETTER_AUTH_URL=https://plexo.yourdomain.com   # Must match PUBLIC_URL

# ── Universal SSO (Phase 1, off by default) ──────────────────
# When PLEXO_SSO_ENABLED=true, /api/sso/handoff and /api/sso/verify
# become available. SSO_HANDOFF_SECRET signs handoff tokens — generate
# with `openssl rand -hex 32`. Sibling apps must share NOTHING here:
# they call /api/sso/verify server-side, never see the secret.
PLEXO_SSO_ENABLED=false                        # set to "true" to enable Phase 1 endpoints
SSO_HANDOFF_SECRET=                            # openssl rand -hex 32 — keep secret

# ── Sprint coding tasks (beta, off by default) ───────────────
# When ENABLE_SPRINT_CODING_TASKS=true, the API accepts code-category
# sprint requests, which run `git clone` + `pnpm install` on the API host
# filesystem with no sandbox. Leave OFF unless you've read
# docs/operations/sprint-coding-flag.md and accept the risk.
ENABLE_SPRINT_CODING_TASKS=false               # set to "true" to enable code-category sprints

# AI provider keys are added in-app via Settings after install.

# ── Marketing landing (cloud only) ───────────────────────────
# Self-hosters: leave unset/false. The dashboard will land on /login.
# Set to `true` ONLY for the managed getplexo.com chrome.
PLEXO_MARKETING_ENABLED=false

# Phase N+1 — clamd malware scanner
CLAMD_HOST=clamd
CLAMD_PORT=3310
CLAMD_SCAN_TIMEOUT_MS=30000
# Stuck-scan recovery threshold (ms). Rows with started_at older than this and
# completed_at NULL are reclaimable. Default 5 min.
CLAMD_STUCK_RECOVERY_MS=300000

# Observability — SLO evaluation + ops alerts (OBS3/OBS4)
# SLO breach detection on router stats. 0 disables the evaluator entirely.
PLEXO_SLO_MIN_SUCCESS=0.85
PLEXO_SLO_MIN_SAMPLES=20
PLEXO_SLO_MAX_P95_MS=0
# Ops-alert delivery. Configure at least one sink, else breaches are log-only.
# Telegram sink (workspace's registered bot token + target chat):
PLEXO_OPS_ALERT_WORKSPACE_ID=
PLEXO_OPS_ALERT_CHAT_ID=
# Fallback webhook sink — receives {text,...counts} JSON (OBS4):
PLEXO_OPS_ALERT_WEBHOOK_URL=
