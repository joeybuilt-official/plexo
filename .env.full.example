# =============================================================================
# Plexo — Full Environment Reference
#
# Every configurable var with inline docs. Copy to .env and fill in what you
# need. Only the vars in .env.example are required to boot.
#
# Generate secrets with: openssl rand -hex 32  (or -hex 64 where noted)
# =============================================================================

# ── Domain / URL ─────────────────────────────────────────────────────────────

# Public URL including protocol (used for OAuth callbacks, links in messages)
PUBLIC_URL=https://plexo.yourdomain.com

# Domain without protocol (used for Caddy TLS, CORS)
PUBLIC_DOMAIN=plexo.yourdomain.com

# ── Secrets ──────────────────────────────────────────────────────────────────

# Database credentials — Postgres will not accept connections without these.
# POSTGRES_USER is fixed to 'plexo' in docker-compose.yml.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=

# Valkey/Redis auth password
# Generate: openssl rand -hex 32
REDIS_PASSWORD=

# Session encryption secret
# Generate: openssl rand -hex 64
SESSION_SECRET=

# AES-256-GCM key for encrypting AI provider credentials at rest
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=

# Internal service-to-service auth (Next.js SSR → API)
# Generate: openssl rand -hex 32
PLEXO_SERVICE_KEY=

# ── Auth (Better Auth) ──────────────────────────────────────────────────────

# Session signing secret for Better Auth
# Generate: openssl rand -hex 64
AUTH_SECRET=

# Public URL for Better Auth (must match PUBLIC_URL)
BETTER_AUTH_URL=https://plexo.yourdomain.com

# Cross-app SSO — set to your shared domain so login carries to sibling apps.
# Leave unset in local dev (localhost rejects domain-scoped cookies).
# BETTER_AUTH_COOKIE_DOMAIN=.example.com

# Comma-separated origins Better Auth will accept requests from.
# Required when browser and auth server are on different subdomains.
# BETTER_AUTH_TRUSTED_ORIGINS=https://plexo.example.com,https://app2.example.com

# ── AI Providers (configure in-app via Settings → AI Providers) ─────────────
# Optional — use to pre-seed a provider without UI setup.
# Keys entered in the UI are encrypted at rest via ENCRYPTION_SECRET.

# OpenAI — platform.openai.com
OPENAI_API_KEY=

# Google Gemini — aistudio.google.com
GEMINI_API_KEY=

# Groq — console.groq.com
GROQ_API_KEY=

# Mistral — console.mistral.ai
MISTRAL_API_KEY=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# fal.ai — fal.ai/dashboard/keys (image/video generation)
FAL_KEY=

# ── GitHub OAuth (enables GitHub login + GitHub Actions connection) ──────────
# Create at: github.com/settings/applications/new
# Callback URL: ${PUBLIC_URL}/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Slack (enables Slack channel integration) ────────────────────────────────
# Create at: api.slack.com/apps → OAuth & Permissions
# Redirect URL: ${PUBLIC_URL}/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Google OAuth (Gmail, Google Calendar, Google Drive connections) ───────────
# Create at: console.cloud.google.com → Credentials → OAuth 2.0 Client
# Add ONE authorized redirect URI:
#   ${PUBLIC_URL}/api/oauth/google/callback
# All Google service connections share this single callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram (enables Telegram channel) ──────────────────────────────────────
# Get from @BotFather on Telegram
# Set webhook: ${PUBLIC_URL}/api/telegram/webhook
TELEGRAM_BOT_TOKEN=

# Telegram webhook secret — required when any Telegram channel is configured.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Discord (enables Discord slash commands) ─────────────────────────────────
# Create at: discord.com/developers/applications
# Add interactions endpoint: ${PUBLIC_URL}/api/discord/interactions
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# ── Data Retention ───────────────────────────────────────────────────────────
# Auto-delete session_logs and work_ledger rows older than N days (0 = disabled)
DATA_RETENTION_DAYS=90

# ── Cost Controls ────────────────────────────────────────────────────────────
# Tasks auto-pause when weekly AI spend reaches this amount
API_COST_CEILING_USD=10.00

# ── Sprint Engine ────────────────────────────────────────────────────────────
# Max concurrent sprint workers (reduce if VPS memory is constrained)
MAX_SPRINT_WORKERS=5

# ── Asset Storage ────────────────────────────────────────────────────────────
# Auto-configured by Docker Compose when using MinIO profile.
# Generate: openssl rand -hex 16 (access key), openssl rand -hex 32 (secret)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=plexo-assets
# Uncomment to use external S3 / Cloudflare R2 / Backblaze B2:
# STORAGE_ENDPOINT=https://s3.amazonaws.com

# ── Voice (Deepgram) ────────────────────────────────────────────────────────
# deepgram.com — enables transcription + voice synthesis
DEEPGRAM_API_KEY=

# ── Web Search ───────────────────────────────────────────────────────────────
# Brave Search API key for full web index (free tier: brave.com/search/api)
# Without this, web_search falls back to DuckDuckGo Instant Answer
BRAVE_SEARCH_API_KEY=

# ── Instance ─────────────────────────────────────────────────────────────────
# Unique ID for this Plexo instance (auto-generated by install.sh)
PLEXO_INSTANCE_ID=

# ── Super Admin ──────────────────────────────────────────────────────────────
# Comma-separated list of emails that get auto-promoted to super admin
SUPER_ADMIN_EMAILS=

# ── App Profile Federation ───────────────────────────────────────────────────
# This instance's public URL — used by app profiles connecting to this Core
PLEXO_URL=

# ── Extension Sideloading ────────────────────────────────────────────────────
# Allow workspace owners to install extensions from a raw manifest (no Hub).
# Self-hosted: set to 'true' to enable. See docs/security/extension-security-model.md
ALLOW_SIDELOAD=false

# ── Marketing Landing (cloud only) ───────────────────────────────────────────
# When `true`, the dashboard renders the public getplexo.com landing page at /
# (hero, pricing pitch, feature grid, etc.). When `false` (the default), the
# dashboard is "login-first" — visiting / redirects anonymous users straight
# to /login and authenticated users to /app. Self-hosters should leave this
# unset or `false`. The /privacy and /terms routes stay reachable either way.
#
# Legacy: SKIP_LANDING=true is still honored as a "force off" override.
PLEXO_MARKETING_ENABLED=false

# ── Database (auto-configured by Docker Compose) ────────────────────────────
# Only override if running Postgres outside Docker Compose
# DATABASE_URL=postgresql://plexo:${POSTGRES_PASSWORD}@localhost:5432/plexo

# ── Redis (auto-configured by Docker Compose) ───────────────────────────────
# Only override if running Redis outside Docker Compose
# REDIS_URL=redis://localhost:6379

# ── Sibling Apps (cross-app SSO handoff) ─────────────────────────────────────
# Set these so handoff tokens redirect to the correct domain and
# browser requests from sibling apps pass CORS on this API.
# Values must be the public-facing HTTPS URL with no trailing slash.
# LEVIO_PUBLIC_URL=https://app1.example.com
# CC_PUBLIC_URL=https://app2.example.com
# FYLO_PUBLIC_URL=https://app3.example.com
#
# Alternatively, enumerate all allowed origins (comma-separated):
# CORS_ORIGINS=https://app1.example.com,https://app2.example.com

# ── App Profile Namespace ────────────────────────────────────────────────────
# When set, the migration runner enforces all DDL targets this PG schema.
# Core's own migrations run without this. App profiles set it to their
# declared schemaNamespace (e.g. APP_SCHEMA_NAMESPACE=fylo).
# APP_SCHEMA_NAMESPACE=
