{
  "plexo": "0.4.0",
  "name": "@joeybuilt/levio-bridge",
  "type": "tool",
  "version": "1.0.0",
  "displayName": "Levio Bridge",
  "description": "Proxies tool calls to Levio's data API for email, calendar, and task operations.",
  "author": "Joeybuilt LLC",
  "license": "AGPL-3.0-only",
  "entry": "/app/extensions/core/levio-bridge/dist/index.js",
  "minPexVersion": "0.4.0",
  "homepage": "https://getplexo.com/ext/@joeybuilt/levio-bridge",
  "repository": "https://github.com/joeybuilt-official/plexo",
  "keywords": ["levio", "email", "calendar", "tasks", "bridge"],
  "capabilities": [
    "storage:read"
  ],
  "capabilitiesRationale": {
    "storage:read": "Reads the Levio connection credentials (levio_user_id) to authenticate data API calls."
  },
  "trust": "owner",
  "escalation": {
    "irreversibleActions": ["levio.email.send"],
    "requestsStandingApprovals": false
  },
  "dataResidency": {
    "sendsDataExternally": false,
    "externalDestinations": []
  },
  "resourceHints": {
    "maxInvocationMs": 15000
  }
}
