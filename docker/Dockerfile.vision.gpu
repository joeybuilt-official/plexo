#
# Plexo Vision service — GPU variant (CUDA execution provider).
#
# Same app as Dockerfile.vision, but the runtime carries the CUDA 12 + cuDNN 9
# libraries that onnxruntime-node's prebuilt CUDA provider links against
# (libcudart.so.12, libcublas*.so.12, libcufft.so.11, libcurand.so.10,
# libcudnn.so.9). With those present and VISION_ORT_EP=cuda, CLIP embeddings +
# face detect/recognize run on the GPU; OCR/labels already use the Ollama
# container.
#
# BOTH stages run on the CUDA base so the prebuilt native modules (sharp,
# onnxruntime-node) are built and run against the SAME glibc — mixing
# bookworm-built binaries onto a different glibc silently crashes on import
# (see Dockerfile.vision's musl note for the same class of bug).
#
# Build:  docker build -f docker/Dockerfile.vision.gpu -t plexo-vision:gpu .
# Run:    needs an NVIDIA runtime + a GPU device reservation (see
#         docker-compose.gpu.yml). Falls back to CPU per-op if a node isn't
#         CUDA-supported; falls back entirely to CPU if VISION_ORT_EP!=cuda.

ARG CUDA_BASE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

FROM ${CUDA_BASE} AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@latest --activate

# ── Install deps (same CUDA/glibc base as runtime) ─────────────────────
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/vision/package.json apps/vision/
RUN pnpm install --frozen-lockfile --filter @plexo/vision...

# ── Runtime ────────────────────────────────────────────────────────────
FROM base AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends wget && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 plexo && \
    useradd --system --uid 1001 --gid plexo --create-home plexo

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/vision/node_modules ./apps/vision/node_modules
COPY package.json pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY apps/vision ./apps/vision

RUN mkdir -p /home/plexo/.plexo/vision/models && \
    chown -R plexo:plexo /app /home/plexo/.plexo

USER plexo
EXPOSE 7000

ENV PORT=7000
ENV MODEL_CACHE_DIR=/home/plexo/.plexo/vision/models
ENV NODE_ENV=production
# GPU on by default in this image; override to "cpu" to force CPU here.
ENV VISION_ORT_EP=cuda
# onnxruntime CUDA provider + transformers.js look here for the CUDA libs.
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu

CMD ["node", "--max-old-space-size=4096", "/app/apps/vision/node_modules/tsx/dist/cli.mjs", "apps/vision/src/index.ts"]
