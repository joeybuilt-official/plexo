FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/hub/package.json apps/hub/
COPY packages/db/package.json packages/db/
COPY packages/logger/package.json packages/logger/

RUN pnpm install --frozen-lockfile --filter @plexo/hub...

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/hub/node_modules ./apps/hub/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
# Root manifest + workspace package.jsons — pnpm 11+ runs deps-status-check
# before --filter build and exits with ERR_PNPM_NO_PKG_MANIFEST if these
# aren't present. The deps stage already had them; the builder stage didn't.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/hub/package.json ./apps/hub/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/logger/package.json ./packages/logger/package.json
COPY tsconfig.base.json ./
COPY apps/hub ./apps/hub
COPY packages/db ./packages/db
COPY packages/logger ./packages/logger

RUN pnpm --filter @plexo/hub build

FROM node:22-alpine AS runner
WORKDIR /app
RUN addgroup --system --gid 1001 plexo && \
    adduser --system --uid 1001 --ingroup plexo plexo
COPY --from=builder --chown=plexo:plexo /app/apps/hub/.next/standalone ./
COPY --from=builder --chown=plexo:plexo /app/apps/hub/.next/static ./apps/hub/.next/static
USER plexo
EXPOSE 3002
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/hub/server.js"]
