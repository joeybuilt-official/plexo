# syntax=docker/dockerfile:1
# Runner jail image (ADR 0050 / plan §9-D2). Confined agent runner: NO sudo,
# NO docker-cli, NO shell-into-host. Everything here is a hardening choice.
FROM node:22-bookworm-slim AS runner
# Match Dockerfile.api base (glibc; official Node team recommendation).

# ca-certificates ONLY — the runner needs TLS trust anchors to reach the
# allowlisted forward-proxy. NO git, NO curl, NO build tools: fewer binaries
# = smaller attack surface for a confined agent.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Non-root identity with a fixed high uid:gid (10001). Fixed + high so it never
# collides with a host system user and so tmpfs/volume ownership is predictable.
RUN groupadd --system --gid 10001 runner \
 && useradd  --system --uid 10001 --gid 10001 --shell /usr/sbin/nologin --home-dir /work runner

WORKDIR /app

# Copy the confinement entrypoint and make it executable at BUILD time — the
# read_only rootfs at runtime means we cannot chmod later.
COPY docker/runner/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Drop to the unprivileged uid by NUMBER (not name) so the rootfs read-only /
# no-new-privileges posture is enforced even if /etc/passwd is unreadable.
USER 10001

# tini-style single-process reaping via node itself is sufficient here; the
# entrypoint applies the wall-clock timeout wrapper.
ENTRYPOINT ["/entrypoint.sh"]
