  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.ts",
    "test:all": "turbo test && pnpm test:unit && pnpm test:integration",
    "test:e2e": "playwright test",
    "e2e:up": "bash scripts/e2e-up.sh",
    "e2e:down": "bash scripts/e2e-down.sh",
    "e2e:test": "E2E_BASE_URL=http://127.0.0.1:3000 E2E_API_URL=http://127.0.0.1:3001 playwright test tests/e2e/p0-*.spec.ts tests/e2e/p1-*.spec.ts tests/e2e/p2-*.spec.ts",
    "e2e:logs": "docker compose -f docker-compose.e2e.yml logs --tail 200 -f",
    "e2e:reset": "bash scripts/e2e-down.sh && bash scripts/e2e-up.sh",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @plexo/db db:generate",
    "db:migrate": "pnpm --filter @plexo/db db:migrate",
    "db:rollback": "pnpm --filter @plexo/db db:rollback",
    "db:studio": "pnpm --filter @plexo/db db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean && rm -rf node_modules",
    "sync-compose": "cp docker-compose.yml docker/compose.yml && [ -f docker-compose.override.yml ] && cp docker-compose.override.yml docker/compose.override.yml || true",
    "prebuild": "pnpm run sync-compose"
  },
  "dependencies": {
    "@plexo/db": "link:packages/db",
    "@plexo/graphiti-bridge": "link:packages/graphiti-bridge"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22",
    "prettier": "^3",
    "tsx": "^4.21.0",
    "turbo": "^2",
    "typescript": "^5.7",
    "undici": "^6",
    "vitest": "^3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joeybuilt-official/plexo.git"
  },
