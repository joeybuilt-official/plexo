# ── Plexo Vision Service — environment ──────────────────────────────
# Copy to .env (or rely on the parent Plexo docker-compose to set these).

# Required: shared HMAC/bearer secret for service-to-service calls.
# Must match the value Plexo's apps/api uses to call the vision service.
PLEXO_SERVICE_KEY=

# HTTP port (matches apps/embeddings convention of one port per worker).
PORT=7000

# ── Models ──────────────────────────────────────────────────────────
# Default model cache directory. The service downloads + verifies SHA-256
# of each .onnx on first request; subsequent requests reuse the cache.
MODEL_CACHE_DIR=

# Optional Joeybuilt-hosted CDN. Falls back to upstream project hosts
# (HuggingFace for OpenCLIP/SigLIP, InsightFace GitHub for buffalo_l,
# RapidOCR HuggingFace for PP-OCRv5) if unset.
MODELS_CDN_URL=

# ── Telemetry (optional) ────────────────────────────────────────────
# When set, the service exports OTLP metrics (inference duration histogram)
# and traces to this endpoint. Mirrors the apps/api OTEL conventions.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=plexo-vision

# pino log level. trace | debug | info | warn | error | fatal
LOG_LEVEL=info
