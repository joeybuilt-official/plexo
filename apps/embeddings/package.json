    "onnxruntime-node": "^1.21.0",
    "pino": "^9",
    "pino-pretty": "^13",
    "tsx": "^4"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^22",
    "typescript": "^5.7",
    "vitest": "^3"
  },
