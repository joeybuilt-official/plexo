{
  "name": "@plexo/embeddings",
  "version": "0.8.0-beta.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=512 dist/index.js",
