# /etc/cron.d/falkordb-backup
# Phase G nightly RDB snapshot. ADR 0030.
#
# This cron is auto-installed + path-templated by your deploy pipeline on every
# deploy (the committed file's `@PLEXO_REPO_DIR@` placeholder is rewritten to
# your checkout path at install time, so operators no longer copy this
# manually). If you install it by hand, substitute @PLEXO_REPO_DIR@ below.
#
# This cron is now a SECONDARY safety net. The falkordb container's
# in-process --save tiers in docker-compose.yml (3600/1, 300/100, 60/10000)
# guarantee BGSAVE fires hourly when there is any write traffic, so the
# host-side `falkordb-backup-stale` alert no longer relies on this cron
# being installed. What this cron uniquely provides is host-side dump.rdb
# rotation under /var/backups/falkordb/ and the weekly off-host S3 upload.
#
# Schedule:
#   - Daily snapshot at 03:30 UTC (low-traffic window)
#   - Weekly off-host upload Sunday 04:00 UTC (after the daily completes)
#
# Required env for off-host upload (set in /etc/default/falkordb-backup or
# inline above the relevant line):
#   AWS_S3_BACKUP_BUCKET=<bucket-name>
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=us-east-1
#
# @PLEXO_REPO_DIR@ below is a placeholder — substitute your plexo checkout path
# before installing (e.g. /usr/local/share/plexo).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

30 3 * * * root @PLEXO_REPO_DIR@/services/graphiti-sidecar/scripts/falkordb_backup.sh >> /var/log/falkordb-backup.log 2>&1
0  4 * * 0 root @PLEXO_REPO_DIR@/services/graphiti-sidecar/scripts/falkordb_backup.sh --offhost-upload >> /var/log/falkordb-backup.log 2>&1
